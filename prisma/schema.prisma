generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  /// When true the customer may pick several services of this category at once.
  multiSelect Boolean   @default(false)
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String          @db.ObjectId
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String          @default("")
  /// VND
  price       Int
}

model Booking {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  scheduledAt  DateTime
  /// VND, sum of the chosen services at booking time
  total        Int
  savePhoto    Boolean  @default(false)
  consulting   Boolean  @default(false)
  completed    Boolean  @default(false)
  /// Free extras the customer ticked
  freeServices String[]
  serviceIds   String[] @db.ObjectId
  userId       String?  @db.ObjectId
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

model ProductCategory {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  image    String
  products Product[]
}

model Product {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String          @db.ObjectId
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  name        String
  /// VND
  price       Int
  image       String
  info        String?
  description String?
  usage       String?
  cartItems   CartItem[]
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  phone        String     @unique
  passwordHash String
  name         String     @default("Khách hàng")
  createdAt    DateTime   @default(now())
  cartItems    CartItem[]
  bookings     Booking[]
}

/// Persistent cart of a logged-in customer.
model CartItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([userId, productId])
}
